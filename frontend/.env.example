# path-findeR — frontend env vars
# Copy to `.env.local` (gitignored) for local dev. Next.js loads it automatically.
# Vars prefixed with NEXT_PUBLIC_ are exposed to the browser; everything else stays
# server-side.

# Base URL the frontend posts to. Match BIND_ADDR on the Go service.
NEXT_PUBLIC_PATH_FINDER_URL=http://localhost:7117
