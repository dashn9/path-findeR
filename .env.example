# path-findeR — service env vars
# Copy to `.env` next to the service binary. Process env always wins over the
# file, so production deployments can ignore this and set vars directly.
# Override the path the service reads via `ENV_FILE=path/to/file`.

# ─── HTTP ─────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:7117

# ─── Storage adapter ──────────────────────────────────────
# Picks which CorpusStore impl is wired in. `local` (default) writes to disk
# under LOCAL_STORAGE_PATH — no S3 creds needed; `s3` for production /
# S3-compatible stores.
STORAGE_ADAPTER=local
LOCAL_STORAGE_PATH=./.data/corpus

# ─── S3 (when STORAGE_ADAPTER=s3) ─────────────────────────
# AWS credentials live here, with the bucket they unlock. Leave the creds blank
# to fall back to the AWS SDK's standard chain (instance role, ~/.aws/, etc.).
# For MinIO / R2 / other S3-compatible stores, set S3_ENDPOINT_URL and
# S3_FORCE_PATH_STYLE=true.
S3_BUCKET=path-finder-corpus
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ENDPOINT_URL=
S3_FORCE_PATH_STYLE=

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
MONGO_DB=path_finder
MONGO_COLLECTION=manifests

# ─── LLM adapter ──────────────────────────────────────────
# `anthropic` | `openai` | `openrouter`. Only the chosen provider's creds need
# to be set — the other blocks stay quiet.
AI_ADAPTER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_VERSION=2023-06-01

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_MODEL=anthropic/claude-sonnet-4

# ─── Pipeline knobs (optional overrides) ──────────────────
# All have defaults in code — override only when tuning.
# PIPELINE_MAX_DIRECT_KB=300
# PIPELINE_TOP_N_NODES=30
# PIPELINE_MAX_SENTENCES=3
# PIPELINE_MAX_SENTENCE_CHARS=500
# PIPELINE_SIMILARITY_THRESHOLD=0.75
# PIPELINE_MAX_RETRIES=3
# PIPELINE_OUTPUT_FORMAT=json
# PIPELINE_MIN_PAGES=2

# Bucket-routing similarity. Pages whose Jaccard score against an existing
# bucket's shape is >= this go in that bucket; otherwise a new bucket is
# created. Lower = more merging, higher = more splitting.
# PIPELINE_SHAPE_SIMILARITY_THRESHOLD=0.75

# Minimum seconds between consecutive pipeline runs for the same bucket.
# Pairs with a "must have new pages since last run" guard to suppress no-op
# re-runs.
# PIPELINE_RERUN_COOLDOWN_SECONDS=60
